# ══════════════════════════════════════════════════════════════════════════════
#  GoogleDoko – Environment Variables Reference
#  Copy this file to src/backend/.env and fill in the values.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Security ──────────────────────────────────────────────────────────────────
# A long random string used to sign JWT tokens.
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=googledoko-change-this-in-production

# ─── Server ────────────────────────────────────────────────────────────────────
# Port the Express API listens on. Default: 4000
PORT=4000

# Set to "production" in production deployments
NODE_ENV=development

# ─── Application URL ───────────────────────────────────────────────────────────
# Public base URL of the app (used to build password-reset links in emails)
APP_URL=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────────
# Absolute path to the folder where googledoko.db is stored.
# Default: <project-root>/src/backend/data/
# DATA_DIR=/var/data/googledoko

# ─── File Uploads ──────────────────────────────────────────────────────────────
# Absolute path to the folder where uploaded product images are saved.
# Default: <project-root>/src/backend/uploads/
# UPLOADS_DIR=/var/data/googledoko/uploads

# ─── Email (Password Reset) ────────────────────────────────────────────────────
# Webhook URL that receives a POST { email, resetUrl } payload and sends the
# email. If not set, the reset link is printed to the server console (dev only).
#
# Example providers:
#   - Make.com / Zapier webhook → connects to Gmail / SendGrid
#   - Resend (https://resend.com): set up a serverless function that calls Resend API
#
# RESET_EMAIL_WEBHOOK=https://hook.eu1.make.com/YOUR_WEBHOOK_ID

# ─── Frontend (Vite) ───────────────────────────────────────────────────────────
# Override the API base URL used by the React frontend.
# Default: http://localhost:4000
# VITE_API_URL=https://api.yourdomain.com
